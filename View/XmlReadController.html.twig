{% extends "Master/MenuTemplate.html.twig" %}

{% block css %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        .json-container {
            background: #f5f5f5;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 15px;
            max-height: 500px;
            overflow-y: auto;
        }
        pre {
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .table-detalles {
            margin-top: 20px;
        }
        .table-detalles th {
            background-color: #f8f9fa;
        }
        .editable {
            cursor: pointer;
            position: relative;
        }
        .editable:hover {
            background-color: #f0f0f0;
        }
        .editable.editing {
            background-color: #fff;
            padding: 0;
        }
        .editable input {
            width: 100%;
            height: 100%;
            border: 1px solid #007bff;
            padding: 4px;
        }
        .delete-row {
            color: #dc3545;
            cursor: pointer;
        }
        .delete-row:hover {
            color: #bd2130;
        }
        .modified {
            background-color: #fff3cd;
        }
        .select2-container {
            width: 100% !important;
        }
        .product-select {
            width: 100%;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            // Inicializar Select2 en todos los selects de productos
            $('.product-select').select2({
                theme: 'bootstrap4',
                placeholder: 'Buscar producto...',
                allowClear: true,
                ajax: {
                    url: '{{ asset("XmlReadController") }}',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return {
                            action: 'search-products',
                            term: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function(data, params) {
                        console.log('Respuesta recibida:', data);
                        
                        if (data.error) {
                            console.error('Error en la búsqueda:', data.message);
                            return {
                                results: [],
                                pagination: {
                                    more: false
                                }
                            };
                        }

                        if (!data.items) {
                            console.error('Formato de respuesta inválido:', data);
                            return {
                                results: [],
                                pagination: {
                                    more: false
                                }
                            };
                        }

                        return {
                            results: data.items,
                            pagination: {
                                more: data.more
                            }
                        };
                    },
                    cache: true,
                    error: function(xhr, status, error) {
                        console.error('Error en la petición AJAX:', {
                            status: status,
                            error: error,
                            response: xhr.responseText
                        });
                    }
                },
                minimumInputLength: 2,
                templateResult: formatProduct,
                templateSelection: formatProductSelection,
                language: {
                    errorLoading: function() {
                        return 'No se pudieron cargar los resultados.';
                    },
                    searching: function() {
                        return 'Buscando...';
                    },
                    noResults: function() {
                        return 'No se encontraron resultados';
                    },
                    loadingMore: function() {
                        return 'Cargando más resultados...';
                    }
                }
            });

            // Formatear el resultado de la búsqueda
            function formatProduct(product) {
                if (product.loading) {
                    return product.text;
                }
                return $('<span>' + product.referencia + ' - ' + product.descripcion + '</span>');
            }

            // Formatear la selección
            function formatProductSelection(product) {
                return product.referencia ? product.referencia + ' - ' + product.descripcion : product.text;
            }

            // Hacer las celdas editables
            $('.editable').click(function() {
                if (!$(this).hasClass('editing')) {
                    const currentValue = $(this).text().trim();
                    const input = $('<input>')
                        .val(currentValue)
                        .addClass('form-control');
                    
                    $(this).html(input);
                    $(this).addClass('editing');
                    input.focus();

                    input.blur(function() {
                        const newValue = $(this).val();
                        const cell = $(this).parent();
                        cell.removeClass('editing');
                        cell.html(newValue);
                        
                        // Marcar como modificado
                        if (newValue !== currentValue) {
                            cell.addClass('modified');
                            cell.closest('tr').addClass('modified');
                            
                            // Si se modificó la referencia o descripción, limpiar el select
                            const columnIndex = cell.index();
                            if (columnIndex === 1 || columnIndex === 2) {
                                const select = cell.closest('tr').find('.product-select');
                                select.val(null).trigger('change');
                            }

                            // Actualizar la caché con los datos modificados
                            updateCache();
                        }
                    });

                    input.keypress(function(e) {
                        if (e.which === 13) {
                            $(this).blur();
                        }
                    });
                }
            });

            // Cuando se selecciona un producto
            $('.product-select').on('select2:select', function(e) {
                const row = $(this).closest('tr');
                const data = e.params.data;
                
                // Guardar los valores originales
                const cantidadOriginal = parseFloat(row.find('td:eq(3)').text().trim());
                const precioUnitarioOriginal = parseFloat(row.find('td:eq(4)').text().replace(/[^0-9.-]+/g, ''));
                const descuentoOriginal = parseFloat(row.find('td:eq(5)').text().replace(/[^0-9.-]+/g, ''));
                const subtotalOriginal = parseFloat(row.find('td:eq(6)').text().replace(/[^0-9.-]+/g, ''));
                const ivaOriginal = parseFloat(row.find('td:eq(7)').text().replace(/[^0-9.-]+/g, ''));
                const totalOriginal = parseFloat(row.find('td:eq(8)').text().replace(/[^0-9.-]+/g, ''));
                
                // Actualizar solo el código principal y la descripción
                row.find('td:eq(1)').text(data.referencia); // Código Principal
                row.find('td:eq(2)').text(data.descripcion); // Descripción
                
                // Restaurar los valores originales
                row.find('td:eq(3)').text(cantidadOriginal); // Cantidad
                row.find('td:eq(4)').text('$' + precioUnitarioOriginal.toFixed(2)); // Precio Unitario
                row.find('td:eq(5)').text('$' + descuentoOriginal.toFixed(2)); // Descuento
                row.find('td:eq(6)').text('$' + subtotalOriginal.toFixed(2)); // Subtotal
                row.find('td:eq(7)').text('$' + ivaOriginal.toFixed(2)); // IVA
                row.find('td:eq(8)').text('$' + totalOriginal.toFixed(2)); // Total
                
                // Guardar la referencia seleccionada en un atributo data
                row.attr('data-selected-reference', data.referencia);
                
                // Marcar la fila como modificada
                row.addClass('modified');

                // Actualizar la caché con los datos modificados
                updateCache();
            });

            // Función para actualizar la caché
            function updateCache() {
                const modifiedData = [];
                
                $('table tbody tr').each(function() {
                    const row = $(this);
                    
                    // Si la fila está marcada como eliminada, no la incluimos
                    if (row.hasClass('deleted')) {
                        return;
                    }
                    
                    const select = row.find('.product-select');
                    const isFromSelect = select.val() !== null && select.val() !== '';
                    
                    // Obtener el código original de la fila
                    const codigoOriginal = row.find('td:eq(1)').text().trim();
                    
                    // Obtener el código principal, priorizando el seleccionado si existe
                    const codigoPrincipal = isFromSelect ? row.attr('data-selected-reference') : codigoOriginal;
                    
                    // Obtener los valores de las celdas, eliminando el símbolo $ y cualquier espacio
                    const cantidad = parseFloat(row.find('td:eq(3)').text().trim());
                    const precioUnitario = parseFloat(row.find('td:eq(4)').text().replace(/[^0-9.-]+/g, ''));
                    const descuento = parseFloat(row.find('td:eq(5)').text().replace(/[^0-9.-]+/g, ''));
                    const subtotal = parseFloat(row.find('td:eq(6)').text().replace(/[^0-9.-]+/g, ''));
                    const iva = parseFloat(row.find('td:eq(7)').text().replace(/[^0-9.-]+/g, ''));
                    
                    const item = {
                        codigoPrincipal: codigoPrincipal,
                        codigoOriginal: codigoOriginal,
                        descripcion: row.find('td:eq(2)').text().trim(),
                        cantidad: cantidad,
                        precioUnitario: precioUnitario,
                        descuento: descuento,
                        precioTotalSinImpuesto: subtotal,
                        impuestos: {
                            impuesto: {
                                valor: iva
                            }
                        },
                        fromSelect: isFromSelect
                    };
                    modifiedData.push(item);
                });

                // Enviar los datos modificados al servidor
                $.ajax({
                    url: '?action=update-table',
                    method: 'POST',
                    data: {
                        action: 'update-table',
                        token: $('input[name="token"]').val(),
                        modifiedData: JSON.stringify(modifiedData)
                    },
                    success: function(response) {
                        console.log('Caché actualizada correctamente');
                    },
                    error: function() {
                        console.error('Error al actualizar la caché');
                    }
                });
            }

            // Función para actualizar los totales de la tabla
            function updateTableTotals() {
                let subtotalSum = 0;
                let ivaSum = 0;
                let totalSum = 0;

                $('table tbody tr').each(function() {
                    const row = $(this);
                    const subtotal = parseFloat(row.find('td:eq(6)').text().replace(/[^0-9.-]+/g, ''));
                    const iva = parseFloat(row.find('td:eq(7)').text().replace(/[^0-9.-]+/g, ''));
                    const total = parseFloat(row.find('td:eq(8)').text().replace(/[^0-9.-]+/g, ''));

                    subtotalSum += isNaN(subtotal) ? 0 : subtotal;
                    ivaSum += isNaN(iva) ? 0 : iva;
                    totalSum += isNaN(total) ? 0 : total;
                });

                $('table tfoot th:eq(0)').text('$' + subtotalSum.toFixed(2));
                $('table tfoot th:eq(1)').text('$' + ivaSum.toFixed(2));
                $('table tfoot th:eq(2)').text('$' + totalSum.toFixed(2));
            }

            // Botón para copiar JSON
            $('#copy-json').click(function() {
                const jsonText = $('#json-output').text();
                navigator.clipboard.writeText(jsonText).then(function() {
                    alert('JSON copiado al portapapeles');
                }, function() {
                    alert('Error al copiar');
                });
            });

            // Eliminar fila
            $(document).on('click', '.delete-row', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                if (confirm('¿Está seguro de que desea eliminar esta fila?')) {
                    const row = $(this).closest('tr');
                    
                    // Marcar la fila como eliminada antes de removerla
                    row.addClass('deleted');
                    
                    // Remover la fila
                    row.remove();
                    
                    // Actualizar los totales de la tabla
                    updateTableTotals();
                    
                    // Actualizar la caché con los datos modificados
                    updateCache();
                }
            });

            // Cuando se envía el formulario
            $('form').on('submit', function(e) {
                e.preventDefault();
                
                // Obtener los datos actuales de la tabla
                const modifiedData = [];
                
                $('table tbody tr').each(function() {
                    const row = $(this);
                    
                    // Si la fila está marcada como eliminada, no la incluimos
                    if (row.hasClass('deleted')) {
                        return;
                    }
                    
                    const select = row.find('.product-select');
                    const isFromSelect = select.val() !== null && select.val() !== '';
                    
                    // Obtener el código original de la fila
                    const codigoOriginal = row.find('td:eq(1)').text().trim();
                    
                    // Obtener el código principal, priorizando el seleccionado si existe
                    const codigoPrincipal = isFromSelect ? row.attr('data-selected-reference') : codigoOriginal;
                    
                    // Obtener los valores de las celdas, eliminando el símbolo $ y cualquier espacio
                    const cantidad = parseFloat(row.find('td:eq(3)').text().trim());
                    const precioUnitario = parseFloat(row.find('td:eq(4)').text().replace(/[^0-9.-]+/g, ''));
                    const descuento = parseFloat(row.find('td:eq(5)').text().replace(/[^0-9.-]+/g, ''));
                    const subtotal = parseFloat(row.find('td:eq(6)').text().replace(/[^0-9.-]+/g, ''));
                    const iva = parseFloat(row.find('td:eq(7)').text().replace(/[^0-9.-]+/g, ''));
                    
                    const item = {
                        codigoPrincipal: codigoPrincipal,
                        codigoOriginal: codigoOriginal,
                        descripcion: row.find('td:eq(2)').text().trim(),
                        cantidad: cantidad,
                        precioUnitario: precioUnitario,
                        descuento: descuento,
                        precioTotalSinImpuesto: subtotal,
                        impuestos: {
                            impuesto: {
                                valor: iva
                            }
                        },
                        fromSelect: isFromSelect
                    };
                    modifiedData.push(item);
                });

                // Agregar los datos modificados al formulario
                $('<input>')
                    .attr('type', 'hidden')
                    .attr('name', 'modifiedData')
                    .val(JSON.stringify(modifiedData))
                    .appendTo($(this));

                // Enviar el formulario
                this.submit();
            });
        });
    </script>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>
                <i class="{{ fsc.getPageData()['icon'] }}"></i> {{ fsc.getPageData()['title'] }}
            </h1>
            <hr/>
        </div>
    </div>
    
    {% if data.error is defined %}
    <div class="row">
        <div class="col-12">
            <div class="alert alert-danger">
                {{ data.error }}
            </div>
        </div>
    </div>
    {% endif %}
    
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Subir Factura Electrónica</h3>
                </div>
                <div class="card-body">
                    <form action="{{ asset('XmlReadController') }}" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="action" value="upload"/>
                        {{ formToken() }}
                        
                        <div class="form-group">
                            <label for="facturafile">Archivo XML de Factura Electrónica</label>
                            <input type="file" class="form-control-file" id="facturafile" name="facturafile" accept=".xml" required/>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-upload fa-fw"></i> Subir y Procesar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    {% if fsc.jsonData is not null %}
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">JSON Generado</h3>
                    <div class="card-tools">
                        <button id="copy-json" class="btn btn-sm btn-info">
                            <i class="fas fa-copy"></i> Copiar JSON
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="json-container">
                        <pre id="json-output">{{ fsc.jsonData|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    </div>
                    
                    <div class="mt-3">
                        <form action="{{ asset('XmlReadController') }}" method="post" class="d-inline">
                            <input type="hidden" name="action" value="process"/>
                            {{ formToken() }}
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-cogs"></i> Extraer Detalles
                            </button>
                        </form>
                        
                        {% if fsc.detallesData is not empty %}
                        <form action="{{ asset('XmlReadController') }}" method="post" class="d-inline ml-2">
                            <input type="hidden" name="action" value="generate-table"/>
                            {{ formToken() }}
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-table"></i> Generar Tabla
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    
{% if fsc.showTable %}
<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-list-ol"></i> Detalles de la Factura ({{ fsc.detallesData|length }} items)
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th width="5%">#</th>
                                <th width="10%">Código</th>
                                <th width="25%">Descripción</th>
                                <th width="8%">Cant.</th>
                                <th width="10%">P. Unitario</th>
                                <th width="10%">Desc.</th>
                                <th width="12%">Subtotal</th>
                                <th width="10%">IVA</th>
                                <th width="10%">Total</th>
                                <th width="10%">Producto</th>
                                <th width="5%">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in fsc.detallesData %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td class="editable">{{ item.codigoPrincipal }}</td>
                                <td class="editable">
                                    <small>{{ item.descripcion }}</small>
                                </td>
                                <td class="editable text-center">{{ item.cantidad }}</td>
                                <td class="editable text-right">${{ item.precioUnitario|number_format(2) }}</td>
                                <td class="editable text-right">${{ item.descuento|number_format(2) }}</td>
                                <td class="editable text-right">${{ item.precioTotalSinImpuesto|number_format(2) }}</td>
                                <td class="editable text-right">
                                    ${{ item.impuestos.impuesto.valor|number_format(2) }}
                                </td>
                                <td class="editable text-right font-weight-bold">
                                    ${{ (item.precioTotalSinImpuesto + item.impuestos.impuesto.valor)|number_format(2) }}
                                </td>
                                <td>
                                    <select class="product-select">
                                        <option></option>
                                    </select>
                                </td>
                                <td class="text-center">
                                    <i class="fas fa-trash delete-row"></i>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="table-active">
                                <th colspan="6" class="text-right">TOTALES:</th>
                                <th class="text-right">
                                    ${{ (fsc.detallesData|default([]))|reduce((sum, item) => sum + item.precioTotalSinImpuesto, 0)|number_format(2) }}
                                </th>
                                <th class="text-right">
                                    ${{ (fsc.detallesData|default([]))|reduce((sum, item) => sum + item.impuestos.impuesto.valor, 0)|number_format(2) }}
                                </th>
                                <th class="text-right">
                                    ${{ fsc.jsonData.infoFactura.importeTotal|default(0)|number_format(2) }}
                                </th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="card-footer text-right">
                <form method="post" action="{{ asset('XmlReadController') }}" enctype="multipart/form-data">
                    <input type="hidden" name="action" value="save-products"/>
                    {{ formToken() }}
                    <button class="btn btn-success" type="submit">
                        <i class="fas fa-save"></i> Guardar productos
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endif %}
</div>
{% endblock %}